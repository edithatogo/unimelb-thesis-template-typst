{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/unimelb-thesis-template-typst/contracts/thesis/v1/manifest.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "candidate-schema-api"
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9._/-]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  },
  "required": [
    "schema_version",
    "contract_version",
    "status",
    "files"
  ],
  "additionalProperties": false
}
