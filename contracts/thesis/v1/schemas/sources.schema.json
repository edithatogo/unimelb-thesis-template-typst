{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/unimelb-thesis-template-typst/contracts/thesis/v1/schemas/sources.schema.json",
  "title": "UMTHESIS 1.0.0 source ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "authority",
          "repository",
          "revision",
          "path",
          "url",
          "clause",
          "retrieved_at",
          "content_sha256",
          "content_scope",
          "qualification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "issue-snapshot",
              "repository-file"
            ]
          },
          "authority": {
            "enum": [
              "project-required",
              "university-required",
              "recommended",
              "experimental",
              "human-decision",
              "historical"
            ]
          },
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "revision": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{40}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[A-Za-z0-9][A-Za-z0-9._/-]*$"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://github\\.com/[^/]+/[^/]+/(?:issues/[1-9][0-9]*|blob/[a-f0-9]{40}/.+)$"
          },
          "clause": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "content_scope": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "qualification": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "issue-snapshot"
                }
              }
            },
            "then": {
              "properties": {
                "revision": {
                  "type": "null"
                },
                "url": {
                  "pattern": "/issues/[1-9][0-9]*$"
                }
              }
            },
            "else": {
              "properties": {
                "revision": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "url": {
                  "pattern": "/blob/[a-f0-9]{40}/"
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    }
  }
}
