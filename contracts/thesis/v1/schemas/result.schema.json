{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/unimelb-thesis-template-typst/contracts/thesis/v1/result.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "required": [
        "revision",
        "tree",
        "dirty"
      ],
      "additionalProperties": false
    },
    "fixture": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "typst",
            "latex"
          ]
        },
        "compiler_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "adapter_version": {
          "const": "1.0.0"
        },
        "tool_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "name",
        "compiler_version",
        "adapter_version",
        "tool_versions"
      ],
      "additionalProperties": false
    },
    "normalized_configuration": {
      "type": [
        "object",
        "null"
      ]
    },
    "configuration_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "generated_at"
      ],
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^[A-Z]{3}-[0-9]{2}$"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "applicability": {
            "type": "string",
            "enum": [
              "applicable",
              "not-applicable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "implementation_state": {
            "type": "string",
            "enum": [
              "planned",
              "implemented"
            ]
          },
          "expected": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unsupported"
            ]
          },
          "result": {
            "type": "string",
            "enum": [
              "executed-pass",
              "executed-fail",
              "unexecuted",
              "blocked",
              "unsupported",
              "not-applicable",
              "human-review-required"
            ]
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "seed": {
            "type": [
              "integer",
              "null"
            ]
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "human_decision_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "required": [
          "requirement_id",
          "source_refs",
          "applicability",
          "reason",
          "implementation_state",
          "expected",
          "result",
          "command",
          "exit_code",
          "seed",
          "duration_seconds",
          "evidence_refs",
          "human_decision_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "document",
              "native-report",
              "semantic-observations",
              "dependencies",
              "fonts",
              "toolchain",
              "validator-report"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "manifest_refs": {
      "type": "object",
      "properties": {
        "dependencies": {
          "type": [
            "string",
            "null"
          ]
        },
        "fonts": {
          "type": [
            "string",
            "null"
          ]
        },
        "toolchain": {
          "type": [
            "string",
            "null"
          ]
        },
        "validators": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "dependencies",
        "fonts",
        "toolchain",
        "validators"
      ],
      "additionalProperties": false
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^[A-Z]{3}-[0-9]{2}$"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "expires": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "requirement_id",
          "scope",
          "owner",
          "rationale",
          "expires"
        ],
        "additionalProperties": false
      }
    },
    "evidence_classification": {
      "const": "public-synthetic"
    }
  },
  "required": [
    "schema_version",
    "contract_version",
    "contract_sha256",
    "source",
    "fixture",
    "engine",
    "normalized_configuration",
    "configuration_sha256",
    "run",
    "requirements",
    "artifacts",
    "manifest_refs",
    "exceptions",
    "evidence_classification"
  ],
  "additionalProperties": false
}
