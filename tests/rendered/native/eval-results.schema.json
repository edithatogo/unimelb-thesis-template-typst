{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "assertion": {
      "type": "boolean",
      "const": true
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "metadata": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "optional_false",
          "optional_null",
          "optional_empty",
          "optional_array",
          "literal",
          "optional_object",
          "optional_zero"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "literal": {
            "type": "string"
          },
          "optional_false": {
            "type": "boolean"
          },
          "optional_null": {
            "type": "null"
          },
          "optional_empty": {
            "type": "string"
          },
          "optional_array": {
            "type": "array"
          },
          "optional_object": {
            "type": "object"
          },
          "optional_zero": {
            "type": "number"
          }
        }
      }
    },
    "optional_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "optional_false",
        "optional_null",
        "optional_empty",
        "optional_array",
        "literal",
        "optional_object",
        "optional_zero"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "literal": {
          "type": "string"
        },
        "optional_false": {
          "type": "boolean"
        },
        "optional_null": {
          "type": "null"
        },
        "optional_empty": {
          "type": "string"
        },
        "optional_array": {
          "type": "array"
        },
        "optional_object": {
          "type": "object"
        },
        "optional_zero": {
          "type": "number"
        }
      }
    },
    "headings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "body"
        ],
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^<[^<>]+>$"
          }
        }
      }
    }
  }
}
