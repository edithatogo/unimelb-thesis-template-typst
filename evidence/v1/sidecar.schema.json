{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/unimelb-thesis-template-typst/evidence/v1/sidecar.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_kind": {
      "const": "umthesis-requirement-evidence"
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "privacy": {
      "const": "internal-not-reviewer-safe"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "const": "edithatogo/unimelb-thesis-template-typst"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "const": false
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._/-]+$",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "git_blob": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "mode": {
                "enum": [
                  "100644",
                  "100755"
                ]
              }
            },
            "required": [
              "path",
              "sha256",
              "git_blob",
              "mode"
            ]
          },
          "minItems": 1
        },
        "inventory_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "repository",
        "revision",
        "tree",
        "dirty",
        "files",
        "inventory_sha256"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "revision": {
          "const": null
        },
        "revision_status": {
          "const": "uncollected-content-bound"
        }
      },
      "required": [
        "sha256",
        "revision",
        "revision_status"
      ]
    },
    "central_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "git_blob": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_id": {
          "const": "central-receipt-schema-current"
        }
      },
      "required": [
        "sha256",
        "git_blob",
        "source_id"
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "requirements_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sources_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fixtures_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "version",
        "manifest_sha256",
        "requirements_sha256",
        "sources_sha256",
        "fixtures_sha256"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "repository": {
          "const": "edithatogo/unimelb-thesis-template-typst"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "run": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "not_before": {
              "type": "string",
              "format": "date-time"
            },
            "review_by": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "not_before",
            "review_by"
          ]
        },
        "native": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._/-]+$",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "schema_version": {
              "const": 1
            }
          },
          "required": [
            "path",
            "sha256",
            "schema_version"
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._/-]+$",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "schema_version": {
              "const": 1
            }
          },
          "required": [
            "path",
            "sha256",
            "schema_version"
          ]
        },
        "sidecars": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "role": {
                "enum": [
                  "coverage",
                  "accessibility",
                  "policy",
                  "reproducibility",
                  "normalized-configuration"
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._/-]+$",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "schema_version": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$"
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "role",
              "path",
              "sha256",
              "schema_version",
              "required"
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "schema_version",
        "repository",
        "revision",
        "tree",
        "run",
        "native",
        "properties",
        "sidecars"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_by": {
      "type": "string",
      "format": "date-time"
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$",
          "minLength": 1
        },
        "passed": {
          "type": "boolean"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "schema_version": {
          "const": 1
        }
      },
      "required": [
        "artifact",
        "passed",
        "started_at",
        "finished_at",
        "schema_version"
      ]
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$",
          "minLength": 1
        },
        "passed": {
          "type": "boolean"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "cases_per_property": {
          "type": "integer",
          "minimum": 0
        },
        "generated_cases": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "exact_revision_execution": {
          "const": "uncollected-legacy-report"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "artifact",
        "passed",
        "seed",
        "cases_per_property",
        "generated_cases",
        "duration_seconds",
        "exact_revision_execution",
        "reason"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compiler": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "python_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tool_versions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "recorded_executable_sha256": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "fonts": {
          "const": "source-identities-uncollected"
        },
        "complete_environment": {
          "const": "uncollected"
        },
        "normalized_configuration": {
          "const": null
        },
        "configuration_sha256": {
          "const": null
        },
        "configuration_binding": {
          "const": "uncollected-legacy-entrypoints"
        }
      },
      "required": [
        "compiler",
        "python_version",
        "tool_versions",
        "recorded_executable_sha256",
        "fonts",
        "complete_environment",
        "normalized_configuration",
        "configuration_sha256",
        "configuration_binding"
      ]
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pointer": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "expected_exit_code": {
            "type": "integer"
          },
          "timed_out": {
            "type": "boolean"
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          },
          "log": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+$",
            "minLength": 1
          },
          "log_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "environment_overrides": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "pointer",
          "command",
          "exit_code",
          "expected_exit_code",
          "timed_out",
          "duration_seconds",
          "log",
          "log_sha256",
          "environment_overrides"
        ]
      },
      "minItems": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+$",
            "minLength": 1
          },
          "original_path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+$",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "enum": [
              "native-report",
              "property-report",
              "native-artifact",
              "sidecar"
            ]
          }
        },
        "required": [
          "path",
          "original_path",
          "sha256",
          "bytes",
          "role"
        ]
      },
      "minItems": 2
    },
    "sidecars": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "schema_version": {
            "type": "string",
            "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$"
          },
          "required": {
            "type": "boolean"
          },
          "artifact": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+$",
            "minLength": 1
          },
          "status": {
            "const": "unsupported"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "role",
          "schema_version",
          "required",
          "artifact",
          "status",
          "reason"
        ]
      },
      "minItems": 0
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{3}-[0-9]{2}$"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "clause": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "retrieved_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "source_id",
                "url",
                "clause",
                "retrieved_at",
                "sha256"
              ]
            },
            "minItems": 1
          },
          "programme_required": {
            "const": true
          },
          "applicability_predicate": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "applicability": {
            "enum": [
              "applicable",
              "unassessed"
            ]
          },
          "applicability_reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "implementation_state": {
            "enum": [
              "planned",
              "implemented"
            ]
          },
          "implementation_basis": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "expected": {
            "const": "executed-pass"
          },
          "result": {
            "enum": [
              "executed-pass",
              "executed-fail",
              "unexecuted",
              "blocked",
              "unsupported",
              "not-applicable",
              "human-review-required"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "scope": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "result": {
                  "enum": [
                    "executed-pass",
                    "executed-fail",
                    "unexecuted",
                    "unsupported"
                  ]
                },
                "evidence_ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._/-]+$",
                  "minLength": 1
                },
                "full_requirement_qualified": {
                  "const": false
                }
              },
              "required": [
                "provider",
                "scope",
                "result",
                "evidence_ref",
                "full_requirement_qualified"
              ]
            },
            "minItems": 0
          },
          "full_requirement_qualified": {
            "const": false
          }
        },
        "required": [
          "id",
          "source_refs",
          "programme_required",
          "applicability_predicate",
          "applicability",
          "applicability_reason",
          "implementation_state",
          "implementation_basis",
          "expected",
          "result",
          "reason",
          "observations",
          "full_requirement_qualified"
        ]
      },
      "minItems": 51,
      "maxItems": 51
    },
    "human_decisions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "not-collected"
        },
        "records": {
          "const": []
        }
      },
      "required": [
        "status",
        "records"
      ]
    },
    "exceptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "unsupported"
        },
        "records": {
          "const": []
        }
      },
      "required": [
        "status",
        "records"
      ]
    },
    "overall_result": {
      "enum": [
        "partial",
        "fail"
      ]
    },
    "full_programme_qualified": {
      "const": false
    },
    "institutional_approval": {
      "const": false
    },
    "blind_safe": {
      "const": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "artifact_kind",
    "profile_sha256",
    "privacy",
    "source",
    "producer",
    "central_schema",
    "contract",
    "request",
    "generated_at",
    "review_by",
    "native",
    "properties",
    "provenance",
    "commands",
    "artifacts",
    "sidecars",
    "requirements",
    "human_decisions",
    "exceptions",
    "overall_result",
    "full_programme_qualified",
    "institutional_approval",
    "blind_safe",
    "limitations"
  ]
}
