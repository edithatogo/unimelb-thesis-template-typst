{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_id": {
      "const": "unimelb-gr-2026-11-15"
    },
    "as_of": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "overall_result": {
      "type": "string",
      "enum": [
        "partial",
        "fail"
      ]
    },
    "data_result": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "invalid"
      ]
    },
    "submission_approved": {
      "const": false
    },
    "privacy": {
      "const": "internal-not-reviewer-safe"
    },
    "evidence_boundary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "configuration_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "pdf_structure": {
              "const": "unexecuted"
            }
          },
          "required": [
            "sha256",
            "bytes",
            "pdf_structure"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "canonical_bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checker_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "policy_manifest_sha256",
        "canonical_bundle_sha256",
        "checker_sha256"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "requirement": {
            "type": "string",
            "enum": [
              "CON-02",
              "POL-01",
              "POL-02",
              "POL-03",
              "POL-04",
              "POL-05",
              "POL-06",
              "POL-07"
            ]
          },
          "applicability": {
            "type": "string",
            "enum": [
              "applicable",
              "not-applicable",
              "unknown"
            ]
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "not-applicable",
              "human-review-required",
              "unexecuted",
              "unsupported",
              "blocked"
            ]
          },
          "basis": {
            "type": "string",
            "enum": [
              "supplied-data",
              "byte-identity",
              "recorded-human-decision",
              "rendered-observation-unexecuted"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "requirement",
          "applicability",
          "result",
          "basis",
          "message",
          "evidence_refs"
        ]
      },
      "minItems": 0
    },
    "human_checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "requirement": {
            "type": "string",
            "enum": [
              "POL-01",
              "POL-02",
              "POL-03",
              "POL-04",
              "POL-05",
              "POL-06",
              "POL-07"
            ]
          },
          "status": {
            "const": "human-review-required"
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "pdf_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "record_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "requirement",
          "status",
          "action",
          "pdf_sha256",
          "record_refs"
        ]
      },
      "minItems": 0
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "counted_words": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_words": {
          "type": "integer",
          "minimum": 1
        },
        "recommended_words": {
          "type": "integer",
          "minimum": 1
        },
        "above_recommendation": {
          "type": "boolean"
        },
        "summary_words": {
          "type": "integer",
          "minimum": 0
        },
        "dissertation_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "creative_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "canonical_publication_bridge": {
      "type": "string",
      "enum": [
        "supported",
        "unsupported-in-revision",
        "unexecuted"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "as_of",
    "generated_at",
    "overall_result",
    "data_result",
    "submission_approved",
    "privacy",
    "evidence_boundary",
    "configuration_sha256",
    "request_sha256",
    "artifact",
    "identities",
    "checks",
    "human_checklist",
    "metrics",
    "canonical_publication_bridge",
    "errors"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
